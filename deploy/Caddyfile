# Proxy reverso com HTTPS automático (Let's Encrypt).
# DOMAIN vem do .env do servidor, ex.: DOMAIN=gustavomartins.dev.br

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy portfolio:8080
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
